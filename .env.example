# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real keys.

# Vision AI provider for meal scanning -- these connect to clem-backend
# (a separate project -- see clem-backend/README.md for deploy steps).
# Leave both blank to use mock scan results during local development.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_APP_SHARED_SECRET=

# Backend (Supabase or equivalent) -- URL is fine client-side, keys are not
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets -- NEVER prefix these with EXPO_PUBLIC_,
# that prefix bundles the value into the client app and exposes it.
SUPABASE_SERVICE_ROLE_KEY=
